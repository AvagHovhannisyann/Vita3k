 // Get the primary network interface name using SystemConfiguration
 bool get_primary_interface_name(char *dest, size_t bufferSize) {
     bool success = false;
@@ -65,6 +69,51 @@ bool get_primary_interface_name(char *dest, size_t bufferSize) {
     CFRelease(store);
     return success;
 }
+#else
+// iOS portability: SCDynamicStoreCreate/CopyValue are explicitly marked
+// unavailable on iOS (SystemConfiguration's dynamic-store API is a macOS-only
+// facility). There is no direct iOS replacement for "the interface backing
+// the default route", so fall back to a plain interface scan: prefer Wi-Fi
+// (en0), then cellular data (pdp_ip0), then the first other up/non-loopback
+// interface. Good enough for the network-identity hint this feeds.
+bool get_primary_interface_name(char *dest, size_t bufferSize) {
+    struct ifaddrs *iflist = nullptr;
+    if (getifaddrs(&iflist) != 0)
+        return false;
+
+    const char *preferred[] = { "en0", "pdp_ip0" };
+    bool success = false;
+
+    for (const char *want : preferred) {
+        for (struct ifaddrs *cur = iflist; cur; cur = cur->ifa_next) {
+            if (!cur->ifa_name || !(cur->ifa_flags & IFF_UP) || (cur->ifa_flags & IFF_LOOPBACK))
+                continue;
+            if (strcmp(cur->ifa_name, want) == 0) {
+                strncpy(dest, cur->ifa_name, bufferSize - 1);
+                dest[bufferSize - 1] = '\0';
+                success = true;
+                break;
+            }
+        }
+        if (success)
+            break;
+    }
+
+    if (!success) {
+        for (struct ifaddrs *cur = iflist; cur; cur = cur->ifa_next) {
+            if (!cur->ifa_name || !(cur->ifa_flags & IFF_UP) || (cur->ifa_flags & IFF_LOOPBACK))
+                continue;
+            strncpy(dest, cur->ifa_name, bufferSize - 1);
+            dest[bufferSize - 1] = '\0';
+            success = true;
+            break;
+        }
+    }
+
+    freeifaddrs(iflist);
+    return success;
+}
+#endif
 
